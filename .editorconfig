# Editor and formatter settings. shfmt reads the [*.sh] section, so CI and editors agree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,py}]
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
space_redirects = true

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4
